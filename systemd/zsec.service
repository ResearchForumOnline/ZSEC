[Unit]
Description=ZSEC Auto Updates security-only run
Documentation=https://github.com/ResearchForumOnline/ZSEC
After=network-online.target apt-daily.service apt-daily-upgrade.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/zsec run
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
